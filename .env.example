# Notion personal access token (https://www.notion.so/developers/tokens). Server-side only.
# Leave empty to run in demo (mock) mode.
NOTION_API_KEY=

# Force demo data even when a token is set.
USE_MOCK=false

# Optional: skip auto-discovery (database ID, data source ID, or Notion URL).
NOTION_ASSIGNMENTS_DB_ID=
NOTION_COURSES_DB_ID=

# Optional: page where "SemesterPilot Plan - <date>" pages are created.
# Defaults to the Assignments database's parent page (or your private workspace section).
NOTION_PLAN_PARENT_PAGE_ID=

# Optional: IANA timezone used to decide what "today" is (defaults to the server's timezone).
PLANNER_TIMEZONE=

# Optional: enables the AI Study Coach (briefing + a concrete first step per block). Server-side only.
OPENAI_API_KEY=
# Optional: model for the coach (default: gpt-6-luna).
OPENAI_MODEL=gpt-6-luna
